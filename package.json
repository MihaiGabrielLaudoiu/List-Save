  "description": "List&Save - comparador de precios y listas de compra con Node.js + MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "echo \"No hay lint configurado\"",
